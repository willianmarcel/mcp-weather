{
  "name": "weather-mcp-server",
  "version": "1.0.0",
  "description": "MCP Server para busca de dados climáticos com suporte a streaming HTTP",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "watch": "tsc --watch",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "client": "tsx src/client.ts",
    "docker:build": "docker build -f deploy/Dockerfile -t weather-mcp:latest .",
    "docker:run": "docker run -p 8080:8080 -p 8081:8081 --env-file .env weather-mcp:latest",
    "docker:compose": "docker-compose -f deploy/docker-compose.yml up",
    "deploy:aks": "./scripts/deploy-aks.sh",
    "deploy:local": "docker-compose -f deploy/docker-compose.yml up -d",
    "clean": "rm -rf dist node_modules"
  },
  "keywords": [
    "mcp",
    "weather",
    "climate",
    "streaming",
    "http",
    "azure",
    "kubernetes",
    "typescript"
  ],
  "author": "Willian Marcel Borges",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.4.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.17",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "ts-jest": "^29.1.2",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
